theme = tokyonight
font-family = "JetBrains Mono Nerd Font"
font-size = 11
window-decoration = false
window-padding-x = 10
window-padding-y = 10
window-padding-color = #1a1b26

# Transparency
window-opacity = 0.95

# Cursor
cursor-style = block
cursor-style-blink = off

# Scrollback
scrollback-limit = 10000

# Shell
shell = /usr/bin/fish

# Mouse
mouse-hide = true

# Performance
sync-terminal-colors = false
